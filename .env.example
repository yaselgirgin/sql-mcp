# ── Provider selection ─────────────────────────────────────────────────────────
# Choose which database engine to connect to. Default: mssql
# Supported values: mssql, postgres
DB_PROVIDER=mssql

# ═══════════════════════════════════════════════════════════════════════════════
# SQL SERVER (DB_PROVIDER=mssql)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Option A: connection string (takes precedence over individual params) ──────
# Standard ADO.NET format. When set, SQL_SERVER / SQL_USER / SQL_PASSWORD are ignored.
# SQL_CONNECTION_STRING=Server=localhost,1433;Database=master;User Id=sa;Password=your_password;Encrypt=false;TrustServerCertificate=true;

# ── Option B: individual connection parameters ─────────────────────────────────
SQL_SERVER=localhost
SQL_PORT=1433
SQL_DATABASE=master
SQL_USER=sa
SQL_PASSWORD=your_password_here

# Set to true for Azure SQL or when SQL Server uses TLS (recommended in prod)
SQL_ENCRYPT=false

# Set to true when using a self-signed certificate in dev/test
SQL_TRUST_SERVER_CERTIFICATE=true

# Query timeout in milliseconds (default: 30000)
SQL_REQUEST_TIMEOUT=30000

# ═══════════════════════════════════════════════════════════════════════════════
# POSTGRESQL (DB_PROVIDER=postgres)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Option A: connection string ────────────────────────────────────────────────
# PG_CONNECTION_STRING=postgresql://user:password@localhost:5432/mydb

# ── Option B: individual connection parameters ─────────────────────────────────
# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE=postgres
# PG_USER=postgres
# PG_PASSWORD=your_password_here
# PG_SSL=false

# ── Option C (optional): Microsoft Entra (Azure AD) token auth ─────────────────
# For Azure Database for PostgreSQL with Entra-only authentication. When enabled,
# the access token is minted on demand via the Azure CLI credential (equivalent to
# `az account get-access-token --resource https://ossrdbms-aad.database.windows.net`)
# and refreshed automatically — no PG_PASSWORD and no stored secret. Requires an
# active `az login`. SSL is forced on. Use individual params below (not PG_CONNECTION_STRING).
# PG_AZURE_AD_AUTH=true
# PG_HOST=myserver.postgres.database.azure.com
# PG_DATABASE=mydb
# PG_USER=my_entra_principal   # the AAD user/group mapped as a PostgreSQL role

# Statement timeout in milliseconds (default: 30000)
# PG_STATEMENT_TIMEOUT=30000

# ═══════════════════════════════════════════════════════════════════════════════
# SHARED SETTINGS (apply to all providers)
# ═══════════════════════════════════════════════════════════════════════════════

# Set PORT to enable HTTP mode (for Docker / remote deployments)
# Leave unset for stdio mode (default, used by Claude Code CLI)
# PORT=3000

# Access level — currently only 'read' is supported
# SQL_ACCESS_LEVEL=read

# ── Policy / data privacy ──────────────────────────────────────────────────────
# Comma-separated list of schemas the MCP is allowed to access.
# When unset, all schemas are accessible.
# SQL_ALLOWED_SCHEMAS=dbo,reporting

# Comma-separated list of tables to block entirely (schema.table format).
# Blocked tables are hidden from listing tools and raise an error when accessed directly.
# SQL_BLOCKED_TABLES=dbo.secrets,hr.salaries

# Comma-separated list of columns to mask in query results (schema.table.column format).
# Matched column values are replaced with "[MASKED]" in all responses.
# SQL_MASKED_COLUMNS=dbo.users.ssn,dbo.users.credit_card

# Hard cap on rows returned by any tool (default: 5000).
# SQL_MAX_ROWS=5000

# ── Audit logging ──────────────────────────────────────────────────────────────
# Connection string for the audit database (recommended: use a dedicated write-capable login).
# When set, every tool call is recorded in the audit.mcp_audit_log table.
# AUDIT_CONNECTION_STRING=Server=localhost,1433;Database=AuditDb;User Id=audit_writer;Password=...;

# Alternative: reuse the main SQL_* params but write to a different database.
# AUDIT_DATABASE=AuditDb

# Directory for daily-rotating audit JSON log files (default: logs/).
# Each file is named audit-YYYY-MM-DD.log (UTC date). One JSON record per line.
# AUDIT_LOG_PATH=logs
